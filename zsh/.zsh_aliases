# --- ls ---
alias l='ls -lah'
alias la='ls -la'
alias ll='ls -l'
alias lsa='ls -lah'
alias sl='ls'

# --- directory navigation ---
alias ...='cd ../..'
alias ....='cd ../../..'
alias -- -='cd -'
alias 1='cd -1'
alias 2='cd -2'
alias 3='cd -3'
alias d='dirs -v'

# --- git (subset of prezto's git module) ---
alias g='git'

alias ga='git add'
alias gaa='git add --all'
alias gapa='git add --patch'

alias gb='git branch'
alias gba='git branch -a'
alias gbd='git branch -d'
alias gbD='git branch -D'

alias gc='git commit -v'
alias gcm='git commit -m'
alias gca='git commit -v --amend'
alias gcan='git commit -v --amend --no-edit'

alias gco='git checkout'
alias gcb='git checkout -b'

alias gd='git diff'
alias gds='git diff --staged'

alias gf='git fetch'
alias gfa='git fetch --all --prune'

alias gl='git log --oneline --graph --decorate'
alias gla='git log --oneline --graph --decorate --all'

alias gm='git merge'

alias gp='git push'
alias gpf='git push --force-with-lease'
alias gpu='git push -u origin HEAD'
alias gpc='git push --set-upstream origin $(git symbolic-ref --short HEAD)'

alias gr='git remote'
alias grv='git remote -v'

alias grb='git rebase'
alias grbi='git rebase -i'
alias grbc='git rebase --continue'
alias grba='git rebase --abort'

alias gst='git status'
alias gss='git status -s'

alias gsta='git stash'
alias gstp='git stash pop'
alias gstl='git stash list'

alias gclean='git clean -fd'

# --- misc ---
alias c='clear'
alias h='history'
alias reload='source ~/.zshrc'
alias yolo="claude --allow-dangerously-skip-permissions"
alias open_ports="lsof -i -P -n | grep LISTEN"

# --- worktree ---
wtnew() {
  local branch="$1"
  if [ -z "$branch" ]; then echo "Usage: wtnew <branch-name>"; return 1; fi
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -z "$root" ]; then echo "Not inside a git repository"; return 1; fi
  local dir="$root/.worktrees/$branch"
  mkdir -p "$root/.worktrees"
  git -C "$root" worktree add "$dir" -b "$branch"
  cd "$dir"
}

wtrm() {
  local branch="$1"
  if [ -z "$branch" ]; then echo "Usage: wtrm <branch-name>"; return 1; fi
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -z "$root" ]; then echo "Not inside a git repository"; return 1; fi
  git -C "$root" worktree remove "$root/.worktrees/$branch"
}

# --- ssh key management ---

# Reuse a running agent. `ssh-add -l` exits 2 only when no agent is reachable;
# 0 (keys loaded) and 1 (agent up, no keys) both mean one is already running.
_dotfiles_ssh_agent() {
  ssh-add -l >/dev/null 2>&1
  [ $? -ne 2 ] && return 0
  eval "$(ssh-agent -s)" >/dev/null
}

_dotfiles_ssh_add() {
  if [ "$(uname -s)" = "Darwin" ]; then
    ssh-add --apple-use-keychain "$1" 2>/dev/null || ssh-add "$1"
  else
    ssh-add "$1"
  fi
}

# Generating over an existing key silently revokes your access to everything
# that trusts it, so refuse unless --force is given.
_dotfiles_gen_key() {
  local key="$1" comment="$2" force="$3" label="$4"

  if [ -e "$key" ] && [ "$force" != "--force" ]; then
    echo "Key already exists: $key" >&2
    echo "" >&2
    echo "Hosts that trust it (GitHub, remote machines) would stop accepting" >&2
    echo "you until the new public key is uploaded everywhere. To replace it:" >&2
    echo "    ${funcstack[2]:-<command>} $comment --force" >&2
    return 1
  fi

  ssh-keygen -t ed25519 -C "$comment" -f "$key" || return 1
  _dotfiles_ssh_agent
  _dotfiles_ssh_add "$key"

  echo ""
  echo "$label"
  cat "$key.pub"
  if [ -n "${CLIPBOARD_CMD:-}" ] && cat "$key.pub" | eval "$CLIPBOARD_CMD" 2>/dev/null; then
    echo "(copied to clipboard)"
  fi
}

# Key for git hosting: GitHub, GitLab.
dotfiles-gen-git-key() {
  local email="" force="" a
  for a in "$@"; do
    case "$a" in
      --force) force="--force" ;;
      *)       email="$a" ;;
    esac
  done
  if [ -z "$email" ]; then
    echo "Usage: dotfiles-gen-git-key <email> [--force]"
    return 1
  fi
  _dotfiles_gen_key "$HOME/.ssh/id_ed25519_git" "$email" "$force" \
    "Public key — add to GitHub/GitLab (Settings > SSH keys):"
}

# Key for reaching other machines over SSH, deployed with ssh-copy-id.
dotfiles-gen-machine-key() {
  local name="" force="" a
  for a in "$@"; do
    case "$a" in
      --force) force="--force" ;;
      *)       name="$a" ;;
    esac
  done
  [ -z "$name" ] && name="$(hostname -s 2>/dev/null || hostname)"
  _dotfiles_gen_key "$HOME/.ssh/id_ed25519_machines" "$name" "$force" \
    "Public key — deploy with: ssh-copy-id -i ~/.ssh/id_ed25519_machines.pub user@host"
}
