# IgnoreUnknown lets this one config work on both macOS and Linux:
# UseKeychain is macOS-only and older/Linux OpenSSH aborts on unknown keywords.
Host github.com
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519_git

Host gitlab.com
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519_git

# --- Machine-to-machine SSH ---
# New keys come from dotfiles-gen-machine-key (-> id_ed25519_machines).
# Pre-existing purpose-named keys keep their own entry.

Host livingroom
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519_livingroom

# Example for a new host:
# Host optiplex
#   HostName 192.168.0.115
#   User your-user
#   IdentityFile ~/.ssh/id_ed25519_machines
#   AddKeysToAgent yes
