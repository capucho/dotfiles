# Cross-platform settings only. Anything OS- or machine-specific belongs in
# the os-local include at the bottom, stowed from hosts/<hostname>/.
font-feature = -calt, -liga, -dlig

# Always open zsh, regardless of the account's login shell. Without this
# Ghostty falls back to $SHELL or the passwd entry, which is bash on a fresh
# Omarchy install and only changes after chsh plus a full logout. Left as a
# bare name so it resolves via PATH: /bin/zsh on macOS, /usr/bin/zsh on Arch.
command = zsh

# Omarchy keeps a symlink to the active system theme here, so switching theme
# in Omarchy also themes the terminal. The '?' prefix makes the include
# optional, so this file still works on machines without Omarchy. The path
# moved between Omarchy versions, so both known locations are tried.
config-file = ?~/.config/omarchy/current/theme/ghostty.conf
config-file = ?~/.local/state/omarchy/current/theme/ghostty.conf

# Per-machine overrides, stowed from hosts/<hostname>/. Kept outside
# ~/.config/ghostty on purpose: if the host package also linked into that
# directory, stow --restow ghostty would try to fold it into one symlink and fail.
# Ghostty applies config-file includes at the end of the
# file, in order, so this one wins over the theme includes above. On macOS it
# sets the theme; on Omarchy the file is absent, so the system theme applies.
config-file = ?~/.config/ghostty-os-local
