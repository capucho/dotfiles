# SSH — never commit keys or host state.
# The install scripts pre-create ~/.ssh as a real directory so stow cannot
# fold it into this repo; these rules are a second line of defence.
ssh/.ssh/*
!ssh/.ssh/config

# Git identity — written by the install script, intentionally untracked
git/.config/git/config.local

# AWS live config — only the template is tracked
aws/.aws/config
aws/.aws/credentials

# Tmux plugins — TPM clones into ~/.config/tmux/plugins, which stow folds
# into this repo, so the clones land here. Never track them.
tmux/.config/tmux/plugins/

# Herdr runtime state
herdr/.config/herdr/herdr-client.log
herdr/.config/herdr/herdr-client.sock
herdr/.config/herdr/herdr-server.log
herdr/.config/herdr/herdr.sock
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/onboarding

# Claude state (auto-generated)
claude/.claude/cache/
claude/.claude/history.jsonl
claude/.claude/sessions/
claude/.claude/daemon*
claude/.claude/plugins/
claude/.claude/projects/
claude/.claude/agent-memory/
claude/.claude/backups/
claude/.claude/downloads/
claude/.claude/hooks/
claude/.claude/jobs/
claude/.claude/plans/
claude/.claude/shell-snapshots/
claude/.claude/state/
claude/.claude/chrome/
claude/.claude/debug/
claude/.claude/paste-cache/
claude/.claude/mcp-needs-auth-cache.json
claude/.claude/stats-cache.json
claude/.claude/README.md

# Claude synced skills (managed externally)
claude/.claude/skills/synced/

# macOS
.DS_Store
